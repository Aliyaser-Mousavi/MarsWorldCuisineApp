{
  "expo": {
    "name": "Mars World Cuisine",
    "slug": "marsWorldCuisine",
    "scheme": "marsworldcuisine",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.aliyaser.marsworldcuisine",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#24160F"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "marsworldcuisine",
              "host": "reset-password"
            },
            {
              "scheme": "marsworldcuisine",
              "host": "auth"
            },
            {
              "scheme": "marsworldcuisine"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aliyaser.marsworldcuisine",
      "buildNumber": "1",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "UISupportsDocumentBrowser": true
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#24160F"
        }
      ],
      "expo-sharing",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "028ef2ef-4ffb-473d-a720-c408eed8b434"
      }
    }
  }
}
